{
  "name": "reqcanvas",
  "private": true,
  "description": "ReqCanvas: levantamiento colaborativo de requisitos sobre diagramas UML de actividades",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint . && pnpm run lint:py",
    "lint:py": "uv run --directory apps/analytics ruff check . && uv run --directory apps/analytics ruff format --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck && pnpm run typecheck:e2e && tsc -p tests/repo && pnpm run typecheck:py",
    "typecheck:py": "uv run --directory apps/analytics mypy",
    "test": "pnpm -r run test && pnpm run test:repo && pnpm run test:py",
    "test:py": "uv run --directory apps/analytics pytest --cov",
    "dev:up": "docker compose -f infra/docker-compose.yml up -d --build",
    "dev:down": "docker compose -f infra/docker-compose.yml down",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "typecheck:e2e": "tsc -p e2e",
    "test:repo": "vitest run -c tests/repo/vitest.config.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ],
    "apps/analytics/**/*.py": [
      "uv run --directory apps/analytics ruff check --fix",
      "uv run --directory apps/analytics ruff format"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/lint": "^21.2.3",
    "@commitlint/load": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
