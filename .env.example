# Variables para ejecutar los servicios fuera de Docker (`pnpm --filter @reqcanvas/api dev`).
# `pnpm dev:up` (Docker Compose) no necesita este archivo.
# Referencia completa: specs/001-plataforma-base/contracts/env-vars.md

# api
NODE_ENV=development
PORT=3000
HOST=::
MONGO_URL=mongodb://localhost:27017
MONGO_DB=reqcanvas
REDIS_URL=redis://localhost:6379
ANALYTICS_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
FEATURE_FLAGS=

# analytics (usa PORT=8000 al ejecutarlo por separado)
ENV=development
