# Variables para ejecutar los servicios fuera de Docker (`pnpm --filter @reqcanvas/api dev`).
# `pnpm dev:up` (Docker Compose) no necesita este archivo.
# Referencia completa: specs/001-plataforma-base/contracts/env-vars.md

# api
NODE_ENV=development
PORT=3000
HOST=::
MONGO_URL=mongodb://localhost:27017
MONGO_DB=reqcanvas
REDIS_URL=redis://localhost:6379
ANALYTICS_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
FEATURE_FLAGS=
# Sesión (feature 002). En Railway, un secreto aleatorio de ≥ 32 bytes por entorno.
JWT_SECRET=dev-only-jwt-secret-not-for-production-use
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
APP_BASE_URL=http://localhost:5173
# Bucket S3 (feature 003). En local, RustFS (`pnpm test:services:up` o `pnpm dev:up`); en
# Railway, referencias al bucket del entorno (`${{reqcanvas.ENDPOINT}}`…).
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=reqcanvas
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true

# analytics (usa PORT=8000 al ejecutarlo por separado)
ENV=development
