{
  "name": "@reqcanvas/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "migrate:up": "tsx --env-file-if-exists=../../.env src/db/cli.ts up",
    "migrate:down": "tsx --env-file-if-exists=../../.env src/db/cli.ts down",
    "migrate:status": "tsx --env-file-if-exists=../../.env src/db/cli.ts status",
    "migrate:create": "migrate-mongo create",
    "migrate:deploy": "node dist/migrate.js auto"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.2",
    "socket.io-client": "^4.8.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.0",
    "@node-rs/argon2": "^2.2.1",
    "@reqcanvas/shared": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^6.3.10",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "file-type": "^22.1.1",
    "ioredis": "^6.0.0",
    "migrate-mongo": "^14.0.7",
    "mongodb": "^7.6.0",
    "mongoose": "^9.10.2",
    "openapi-types": "^12.1.3",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  }
}
