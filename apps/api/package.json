{
  "name": "@reqcanvas/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "migrate:up": "tsx --env-file-if-exists=../../.env src/db/cli.ts up",
    "migrate:down": "tsx --env-file-if-exists=../../.env src/db/cli.ts down",
    "migrate:status": "tsx --env-file-if-exists=../../.env src/db/cli.ts status",
    "migrate:create": "migrate-mongo create",
    "migrate:deploy": "node dist/migrate.js up"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@reqcanvas/shared": "workspace:*",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^6.0.0",
    "migrate-mongo": "^14.0.7",
    "mongodb": "^7.6.0",
    "mongoose": "^9.10.2",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  }
}
