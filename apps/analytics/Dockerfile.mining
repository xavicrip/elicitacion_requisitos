# syntax=docker/dockerfile:1
# Imagen de analysis-worker (feature 007, ADR 0009): minería de texto con los modelos incluidos,
# sin descargas en tiempo de ejecución. Contexto de build: raíz del repositorio.
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS build
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY apps/analytics/pyproject.toml apps/analytics/uv.lock ./
RUN uv sync --frozen --no-dev --group mining --no-install-project
COPY apps/analytics/src ./src
RUN uv sync --frozen --no-dev --group mining --no-editable
# Modelos de Hugging Face en la imagen (embeddings multilingües y sentimiento en español).
ENV HF_HOME=/app/models
RUN .venv/bin/python -c "\
from sentence_transformers import SentenceTransformer; \
from transformers import AutoModelForSequenceClassification, AutoTokenizer; \
SentenceTransformer('sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2'); \
name = 'pysentimiento/robertuito-sentiment-analysis'; \
AutoTokenizer.from_pretrained(name); AutoModelForSequenceClassification.from_pretrained(name)"

FROM python:3.12-slim-bookworm AS runtime
ARG APP_VERSION=dev
ARG GIT_SHA=unknown
ENV PATH=/app/.venv/bin:$PATH PYTHONUNBUFFERED=1 APP_VERSION=$APP_VERSION GIT_SHA=$GIT_SHA \
    HF_HOME=/app/models HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
RUN useradd --create-home --uid 10001 app
WORKDIR /app
COPY --from=build --chown=app:app /app/.venv /app/.venv
COPY --from=build --chown=app:app /app/models /app/models
USER app
EXPOSE 8001
CMD ["python", "-m", "analytics.mining.worker"]
